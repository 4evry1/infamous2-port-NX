# inFAMOUS 2 for the Switch: settings, read at start from sdmc:/switch/infamous2-port/env.txt (KEY=VALUE per line,
# # starts a comment). Delete a line to go back to the built-in default.

# The upper-left version and FPS display is on in both launchers. Set to 0 to hide it.
#HZ_FPS_HUD=0

# Internal resolution: 1.0 = 1280x720 (default), 0.75 = 960x540, 0.5 = 640x360. The port is CPU bound, so a lower
# resolution does not make it faster.
#PS3RECOMP_RENDER_SCALE=0.75

# Edge Geometry triangle culling on the SPU threads: 0 skips it and lets the GPU cull (faster here).
PS3RECOMP_MESH_TRIM=0

# The game's own cutscene movies play (the default). For testing only: HZ_FAST_MOVIES=1 replaces every cutscene
# movie with the disc's 4 second placeholder (and skips the 8 minute opening).
#HZ_FAST_MOVIES=1

# Native Edge Geometry kernels (Thiago's natives via upstream; PS3_NATIVE_EDGE=0 turns them all off).
PS3_EDGE_MEMO=1
PS3_EDGE_SKIN=1
# Vertex compression natively (it checks its NEON path against the generic one on first use).
PS3_NATIVE_EDGE_ENC=1
# Index decompression natively: 1 = on, 2 = a check run (native and original both run; the log reports differences).
PS3_NATIVE_EDGE_IDX=1

# Native SPU jobs: 210 (culling-tree walk), 208 (instance culler), 209 (detail level and fade updater), 211 (normal map of
# the water grid), 216 (BSP polygon clipper), 218 (skeletal animation: pose blends, rotation unpacking, joint matrices),
# 201 (the job's back-to-front sort of 36-byte records by distance from a point).
# 0 = the original code. For 218, 211, 209 and 201, 2 = a check run: every call also runs the original and the log reports
# any difference ("[j218] ... differ N", "[j211] ... differ N", "[j209] ... differ N", "[j201] ... differ N").
PS3RECOMP_NATIVE_BC11=1
PS3RECOMP_NATIVE_J207=1
PS3_NATIVE_J209=1
PS3_NATIVE_J211=1
PS3_NATIVE_J220=1
PS3_NATIVE_J218=1
PS3_NATIVE_J201=1
# The first loop of SPU jobs 212 and 210 (they clear their data area) natively: 0 = the original loop, 2 = a check run
# (the log reports "[j212] ... differ N").
PS3_NATIVE_J212=1

# Frames in flight: 2 lets the CPU record the next frame while the GPU draws this one. 1 if the picture flickers.
PS3RECOMP_VK_FIF=2

# Game step limit: below 15 fps the game would run in slow motion; 70 ms keeps game time near real time down to
# about 14 fps without upsetting physics. Put a # in front if the camera or physics misbehave.
PS3_GAME_MAX_DT_MS=70

# SPU threads sleep at once instead of polling a channel first (every core is busy on the Switch).
PS3_SPU_SPIN_US=0

# Audio: the Wwise thread at priority 57 and the game's one-SPU audio group at 58, ahead of the busy SPU workers.
HZ_PRIO_NAMES=AK::EventManager:57,CellSpursKernelGroup/1:58
# Blocks the mixer keeps queued, and how long it waits for a late block instead of playing a gap.
AUDIO_QUEUE_BLOCKS=6
AUDIO_HOLD_MS=20
#AUDIO_RATE=1

# How long the GPU command walker waits for the game to patch a command-buffer park before skipping ahead
# (skipping loses the picture). The built-in value is 5000.
#GCM_PARK_GRACE_MS=5000

# The game's own detail ladder used as a floor (1..20; 0 or no line = full detail). Saves a little CPU, costs detail.
#HZ_DETAIL_STEP=3

# Profiling. Sampling profiles (logs/profile-N.bin) at these seconds after start; delete the line to stop them.
#HZ_PROFILE_AT=200,300,400
# A timeline of every wait for <seconds> from <start> (logs/ftrace.txt; the game pauses while it is written).
# Read it with: python3 switch/tools/ftrace_crit.py ftrace.txt
#PS3_FTRACE=230:15:sdmc:/switch/infamous2-port/logs/ftrace.txt
#PS3_FTRACE_CAP=2000000
#PS3_JOBSTAT=1
